<?xml version="1.0"?>
<package format="3">
  <name>touch_common</name>
  <version>0.1.0</version>
  <description>ROS 2 Nodes for Sensable Phantom Touch devices.</description>

  <maintainer email="fsuarez6@gmail.com">Francisco Suarez-Ruiz</maintainer>
  <author>Francisco Suarez-Ruiz</author>
  <license>BSD</license>

  <url type="website">https://github.com/fsuarez6/phantom_touch</url>
  <url type="repository">https://github.com/fsuarez6/phantom_touch</url>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Common dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>kdl_parser</depend>
  <depend>touch_msgs</depend>               <!-- Custom messages -->
  <depend>robot_state_publisher</depend>   <!-- Optional runtime -->
  <depend>xacro</depend>                   <!-- If URDFs are still used -->

  <!-- Optional: Bullet if needed -->
  <depend>bullet</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <!-- Export -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
